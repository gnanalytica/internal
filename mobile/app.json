{
  "expo": {
    "name": "Internal",
    "slug": "internal",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "internal",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gnanalytica.internal",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5e6ad2"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.gnanalytica.internal",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#5e6ad2",
          "dark": {
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Internal lets you attach photos from your library to issues, pages and comments."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://internal.gnanalytica.com",
      "router": {},
      "eas": {
        "projectId": "e06d6da6-eca9-4a93-982a-6e6d01a88543"
      }
    },
    "owner": "gnanalytica",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
